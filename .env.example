# ==============================================================================
# Tourist Management System - Production Environment Configuration Template
# Copy this file to .env and provide your production credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# JSON Web Token Secret (generate a cryptographically secure random string for production)
# e.g., openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# Google Gemini AI Integration (Optional: App includes intelligent fallback engine if not provided)
GEMINI_API_KEY=

# Supabase PostgreSQL Database (Optional: App seamlessly falls back to resilient built-in in-memory store)
# Obtain these from your Supabase Dashboard: Settings -> API & Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=
